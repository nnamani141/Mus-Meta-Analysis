forest_sex <- function(g) {
  yi  <- c(as.numeric(Male_logFC[g, ]),  as.numeric(Female_logFC[g, ]))
  sei <- c(as.numeric(Male_SE[g, ]),     as.numeric(Female_SE[g, ]))
  sex <- c(rep("M", ncol(Male_logFC)), rep("F", ncol(Female_logFC)))
  labs <- c(colnames(Male_logFC), colnames(Female_logFC))
  contr <- c(colnames(Male_logFC), colnames(Female_logFC))
  short <- paste0(study_lookup[contr], " (", sex, ")") # short label: GSE id from study_lookup + sex tag
  
  ok <- is.finite(yi) & is.finite(sei) & sei > 0
  m <- rma(yi[ok], sei = sei[ok], method = "REML")
  ord <- order(sex[ok])
  forest(m, 
         slab = short[ok][ord],
         order = ord,                 # group males then females
         col = ifelse(sex[ok] == "M","navy","darkred")[ord],
         xlab = expression(Log[2]~"FC"), header = "Study (arm)",
         main = paste0(g, "  (Sex-adjusted obesity FDR = ",
                       format.pval(res$intercept_FDR[res$gene==g], 2), ")"),
         cex = 0.7, pch = 15)
}
par(mfrow = c(1, 1)); for (g in top_dimorphic) forest_sex(g); par(mfrow = c(1,1))

