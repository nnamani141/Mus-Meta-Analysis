# DIRECTION-AWARE Z-SCORE
compute_directional_z <- function(p, logFC) {
  # Invalid values become NA
  p[!is.finite(p)] <- NA
  logFC[!is.finite(logFC)] <- NA
  
  p <- pmax(pmin(p, 0.999999), 1e-15) # Avoid infinite boundaries
  z <- qnorm(p / 2, lower.tail = FALSE)
  return(z * sign(logFC))
}

# GENERATE DIRECTIONAL Z-SCORES
for (i in seq_along(study_objects)) {
  
  meta_input_df[[paste0("z_stud", i)]] <-
    compute_directional_z(
      meta_input_df[[paste0("PValue_stud", i)]],
      meta_input_df[[paste0("logFC_stud", i)]]
    )
}

# Execute the 9-Way Weighted Stouffer Math Row-by-Row
# ==============================================================================
run_stouffer <- function(z_scores, weights) {
  
  valid <- is.finite(z_scores) &
    is.finite(weights)
  
  z_scores <- z_scores[valid]
  weights  <- weights[valid]
  
  k <- length(z_scores)
  
  if (k == 0) {
    return(
      c(
        k = 0,
        meta_Z = NA,
        meta_P = NA
      )
    )
  }
  
  numerator <- sum(
    z_scores * weights
  )
  
  denominator <- sqrt(
    sum(weights^2)
  )
  
  meta_Z <- numerator / denominator
  
  meta_P <- 2 * pnorm(
    abs(meta_Z),
    lower.tail = FALSE
  )
  
  c(
    k = k,
    meta_Z = meta_Z,
    meta_P = meta_P
  )
}

