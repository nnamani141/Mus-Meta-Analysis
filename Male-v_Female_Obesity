common <- intersect(rownames(Male_logFC), rownames(Female_logFC))

fit_gene <- function(g) {
  yi  <- c(as.numeric(Male_logFC[g, ]), as.numeric(Female_logFC[g, ]))
  sei <- c(as.numeric(Male_SE[g, ]),    as.numeric(Female_SE[g, ]))
  contr <- c(colnames(Male_logFC), colnames(Female_logFC))
  sex <- c(rep(0.5, ncol(Male_logFC)), rep(-0.5, ncol(Female_logFC)))
  study <- study_lookup[contr]
  
  ok <- is.finite(yi) & is.finite(sei) & sei > 0
  if (sum(ok) < 4) return(c(intercept=NA, intercept_p=NA, sex_coef=NA, sex_p=NA, k=sum(ok)))
  dat <- data.frame(yi=yi[ok], vi=sei[ok]^2, sex=sex[ok], study=study[ok])
  both <- length(unique(dat$sex)) == 2
  m <- tryCatch(
    if (both) rma.mv(yi, vi, mods=~sex, random=~1|study, data=dat, method="REML")
    else      rma.mv(yi, vi,           random=~1|study, data=dat, method="REML"),
    error=function(e) NULL)
  if (is.null(m)) return(c(intercept=NA, intercept_p=NA, sex_coef=NA, sex_p=NA, k=sum(ok)))
  c(intercept=as.numeric(m$b[1]), intercept_p=m$pval[1],
    sex_coef=if(both) as.numeric(m$b[2]) else NA,
    sex_p=if(both) m$pval[2] else NA, k=sum(ok))
}

