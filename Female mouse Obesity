run_random_effects_REML <- function(logFC, SE) {
  
  valid <- is.finite(logFC) &
    is.finite(SE) &
    SE > 0
  
  logFC <- logFC[valid]
  SE    <- SE[valid]
  
  k <- length(logFC)
  
  out <- c(
    k_REML = k,
    pooled_logFC = NA,
    pooled_SE = NA,
    CI_low = NA,
    CI_high = NA,
    REML_P = NA,
    tau2 = NA,
    I2_Percent = NA,
    Cochran_Q = NA,
    Het_PValue = NA
  )
  
  # Need at least 3 studies for a meta-analysis
  if (k < 3) {
    return(out)
  }
  
  fit <- tryCatch(
    
    metafor::rma(
      yi = logFC,
      sei = SE,
      method = "REML",
      level = 95
    ),
    
    error = function(e) NULL
  )
  
  if (is.null(fit)) {
    return(out)
  }
  
  out["pooled_logFC"] <- as.numeric(
    fit$b[1]
  )
  
  out["pooled_SE"] <- fit$se
  
  out["CI_low"] <- fit$ci.lb
  
  out["CI_high"] <- fit$ci.ub
  
  out["REML_P"] <- fit$pval
  
  out["tau2"] <- fit$tau2
  
  out["I2_Percent"] <- fit$I2
  
  out["Cochran_Q"] <- fit$QE
  
  out["Het_PValue"] <- fit$QEp
  
  return(out)
}

