cor_mat <- cor(lfc_mat, use = "pairwise.complete.obs", method = "spearman")
write.csv(round(cor_mat, 3), paste0(dfp, "Obesity_Females_Log2FC_CorMatrix.csv"))
print(round(cor_mat, 2))

# How many genes underlie each pairwise correlation (watch for thin overlap)
n_shared <- crossprod(!is.na(lfc_mat))
cat("\nMin shared genes in any study pair: ", min(n_shared[upper.tri(n_shared)]), "\n", sep = "")

# QC read
cm <- cor_mat; diag(cm) <- NA
cat("\nMean correlation with other studies (low/neg = divergent):\n")
print(round(rowMeans(cm, na.rm = TRUE), 2))
cat("Highest off-diagonal (possible non-independence):",
    round(max(cm, na.rm = TRUE), 2), "\n")



